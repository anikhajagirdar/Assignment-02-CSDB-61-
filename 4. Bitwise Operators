#include <stdio.h>
#include <string.h>
#include <math.h>
#include <stdlib.h>



#include <stdio.h>

void calculate_the_maximum(int n, int k) {
    int max_and = 0;
    int max_or = 0;
    int max_xor = 0;

    int current_and;
    int current_or;
    int current_xor;

    int i;
    int j;

    for (i = 1; i <= n; i++) {
        for (j = i + 1; j <= n; j++) {

            current_and = i & j;
            current_or = i | j;
            current_xor = i ^ j;

            if (current_and < k) {
                if (current_and > max_and) {
                    max_and = current_and;
                }
            }

            if (current_or < k) {
                if (current_or > max_or) {
                    max_or = current_or;
                }
            }

            if (current_xor < k) {
                if (current_xor > max_xor) {
                    max_xor = current_xor;
                }
            }

        }
    }

    printf("%d\n", max_and);
    printf("%d\n", max_or);
    printf("%d\n", max_xor);
}

int main() {
    int n, k;

    scanf("%d %d", &n, &k);
    calculate_the_maximum(n, k);

    return 0;
}
