/*
Add `int max_of_four(int a, int b, int c, int d)` here.
*/

#include <stdio.h>

int max_of_four(int a, int b, int c, int d) {
    // Check if 'a' is bigger than b, c, and d
    if (a >= b && a >= c && a >= d) {
        return a;
    }
    // Check if 'b' is bigger than c and d
    else if (b >= c && b >= d) {
        return b;
    }
    // Check if 'c' is bigger than d
    else if (c >= d) {
        return c;
    }
    // If none of the above, 'd' must be the biggest
    else {
        return d;
    }
}

int main() {
    int a, b, c, d;
    
    // Read 4 integers using scanf
    scanf("%d %d %d %d", &a, &b, &c, &d);
    
    int ans = max_of_four(a, b, c, d);
    
    // Print the result using printf
    printf("%d", ans);
    
    return 0;
}
